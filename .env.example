# Copy to .env (deploy/install.sh does this for you). Never put keys in browser JS or commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_ROUTER_MODEL=gpt-5.4-mini
# Empty = model default. gpt-5.4-mini accepts none/low/medium/high/xhigh.
OPENAI_REASONING_EFFORT=
LIGHTRAG_API_KEY=
KB_VERSION=plimo-estimate-v5
# naive = vector search; scored better and faster than mix on this small KB (qa/results/retrieval-latest.md)
RAG_MODE=naive
# Cost guard: daily OpenAI spend in USD from real token prices (0 = off); optional raw token cap.
# Also set a project budget in the OpenAI dashboard as a second layer.
DAILY_BUDGET_USD=5
DAILY_TOKEN_BUDGET=0
CHAT_IP_PER_HOUR=1200
CHAT_SESSION_PER_HOUR=60
CHAT_MEMBER_PER_HOUR=120
# Set true behind HTTPS (install.sh does this on the VPS).
COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Stripe TEST mode only: sk_test_... keys; live keys are refused by the app.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# VPS: https://your-domain (install.sh sets it); empty locally.
PUBLIC_BASE_URL=
# Chat images: private Cloudflare R2 bucket (token: Object Read & Write on this bucket only).
# Leave empty to store on the server disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=plimo-chat-images
SITE_ADDRESS=
